{
  "manifest_version": 2,
  "name": "Quick Timer",
  "version": "1.0.0",
  "description": "Timer instan — langsung 1 jam, +30 menit sekali klik",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Quick Timer",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}